# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# PriceScout
SERPAPI_KEY=                      # optional — live price search (falls back to mock)
PRICE_SCOUT_DB_PATH=              # optional — defaults to data/price_scout.db

# Reddit (optional — trend agent falls back to mock data if not set)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=TrendAgent/1.0

# Ticketmaster (optional — local events for trend agent)
TICKETMASTER_API_KEY=

# Google Custom Search (optional — product images for trend agent)
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Sales database (trend agent)
DB_PATH=./data/sales.db

# Twilio (SMS/iMessage delivery — autonomous, no macOS permissions needed)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=    # your Twilio number, e.g. +15551234567

# Hex Analytics (optional — ecosystem health dashboard)
HEX_API_TOKEN=                   # Hex API token from app.hex.tech
HEX_PROJECT_ID=                  # Hex project ID for the ecosystem health notebook

# Server ports
PRICE_SCOUT_PORT=8000
TREND_PORT=8001

# Tabula product API (clawbot/api/app.py)
DATABASE_URL=postgresql+psycopg://localhost/tabula_dev
TABULA_AUTH_MODE=auth0            # "dev" = X-Dev-User header, local only (refused when TABULA_ENV=production)
TABULA_ENV=development
TABULA_CORS_ORIGINS=http://localhost:5173
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
